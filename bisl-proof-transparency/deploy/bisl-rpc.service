[Unit]
Description=BISL Proof Transparency RPC
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bisl-deploy/rpc
EnvironmentFile=-/opt/bisl-deploy/rpc/.env.vps
EnvironmentFile=-/opt/bisl-deploy/rpc/.env
Environment=FABRIC_ROOT=/opt/bisl-deploy/fabric
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# ExecStart node path is rewritten by CI/install to the host's real node binary
ExecStart=/usr/bin/env node /opt/bisl-deploy/rpc/app.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
